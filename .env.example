# Copy to .env and fill in real values before running `docker compose up`.
# See docs/environment-variables.md for the full reference (including vars not needed by
# docker-compose.yml itself, like PORT or CUSTOM_NODES_DIR for a non-Docker setup).

# Required — generate real random values, e.g. `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=asdfghjklwsdxcvygfvcsdfghujhdfvgbkjn
N8N_JWT_SECRET=iubfeidskjefodkjydahvscbofilkjdcnxhfujd

# Optional — only needed to change the Postgres credentials from the defaults below.
# DB_POSTGRES_USER=postgres
# DB_POSTGRES_PASSWORD=postgres
# DB_POSTGRES_DATABASE=n8n_clone

# Optional — absolute host path to a directory of custom nodes (see @n8n-clone/node-dev).
# Mount it into the cli container yourself if you set this; docker-compose.yml doesn't do
# that mount for you since the path is host-specific.
# CUSTOM_NODES_DIR=

# Optional — the Workflow Assistant's own model credential. Set this to use the assistant
# without first creating an openAiApi credential through the editor UI. Takes priority over
# any stored credential when set.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
